# Copiar a .env  ·  .env NUNCA se sube al repo
MYSQL_ROOT_PASSWORD=rootlocal
BD_USUARIO=app_ms2
BD_CLAVE=cambiame

# En AWS: IP privada de mv-bd
BD_HOST=10.0.2.__
BD_PORT=3306
BD_NOMBRE=viajes_db

# URL de MS1 a traves del balanceador interno. Sin barra final.
MS1_URL=http://transporte-alb-interno-____.us-east-1.elb.amazonaws.com

# false mientras MS1 no este arriba: POST /ms2/viajes deja de validar
VALIDAR_CON_MS1=false

# La pone P3 cuando cree el API Gateway; va en el servers: del Swagger
PUBLIC_URL=https://____.execute-api.us-east-1.amazonaws.com
